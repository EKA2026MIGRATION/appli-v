; ============================================================
; appli-v — MODELE de configuration
; Copier ce fichier en ".env" (a la racine, gitignore) et renseigner
; les valeurs. Lu par config/config.php via parse_ini_file.
; Commentaires = ";"  (PAS "#", qui casserait parse_ini_file)
; ============================================================

; ---- Chemins de l'application (specifique a la machine) ----
; Sous-dossier de l'app en dev (ex: /appli-v)
folder_app_dev = ""
; Sous-dossier de l'app en prod
folder_app_prod = ""

; ---- API backend ----
; URL de base de l'API (ex: https://api.appli-v.net/ ou http://api.appli-v/)
api_call = ""

; ---- Pagination ----
size_recherche = 20
size_list = 50
week_list = 200

; ---- SMTP — envoi d'emails ----
smtpHost = ""
smtpPort = 587
; Identifiant SMTP (SECRET)
smtpUsername = ""
; Mot de passe SMTP (SECRET)
smtpPassword = ""

; ---- API admin — Basic Auth serveur-a-serveur ----
; Login admin de l'API (SECRET)
apiAdminUsername = ""
; Mot de passe admin de l'API (SECRET)
apiAdminPassword = ""

; ---- Cles de services tiers ----
; Cle Google Maps (exposee cote front)
maps_api_key = ""
; Twilio Account SID (SECRET)
twilio_id = ""
; Twilio Auth Token (SECRET)
twilio_token = ""
; Token SMS Factor (SECRET)
smsFactorToken = ""
; Cle serveur Firebase / push (SECRET)
firebaseKey = ""

; ---- Chiffrement AES (Functions.php encrypt/decrypt) ----
; Cle AES (SECRET)
aesKey = ""
; IV AES (SECRET)
aesIv = ""
